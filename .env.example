# Database configuration (Supabase or PostgreSQL)
# Pooled connection URL for runtime queries:
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?pgbouncer=true"
# Direct connection URL for Prisma migrations:
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Authentication
JWT_SECRET="generate-a-secure-random-secret-here-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server Ports & Environment
PORT=3001
API_PORT=3001
WEB_PORT=3000
NODE_ENV="development"

# GraphQL & Network Routing
# Browser requests always use the same-origin /graphql proxy.
NEXT_PUBLIC_GRAPHQL_URL="/graphql"
# INTERNAL_API_URL: Server-side Next.js route proxy target
INTERNAL_API_URL="http://localhost:3001/graphql"
FRONTEND_URL="http://localhost:3000"

# Background Job Queue (BullMQ + Redis)
# Required for durable monitoring. Use QUEUE_MODE=memory without REDIS_URL only in development.
REDIS_URL="redis://localhost:6379"

# Intelligent Semantic Classification (Optional)
# Requires LLM_ENABLED=true; otherwise classification stays deterministic.
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# Runtime roles: api, scheduler, worker (all for local development)
RUNTIME_ROLE=all
# Memory mode must be explicitly selected and is forbidden in production.
QUEUE_MODE=redis
WORKER_CONCURRENCY=5
MAX_WATCHES_PER_USER=100
MANUAL_CHECKS_PER_HOUR=60
HISTORY_RETENTION_DAYS=90

# AI is opt-in and only used for ambiguous changes; shared Redis daily budget.
LLM_ENABLED=false
LLM_DAILY_CALL_LIMIT=100

# Email provider (in-app alerts work without email credentials)
RESEND_API_KEY=""
EMAIL_FROM="alerts@pageradar.dev"

# Public origin for the server-side cookie proxy, especially behind a reverse proxy.
APP_ORIGIN="http://localhost:3000"
# Required for docker compose's local PostgreSQL service.
POSTGRES_PASSWORD="choose-a-local-database-password"
