generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ChangeType {
  DEADLINE_CHANGED
  ELIGIBILITY_CHANGED
  STATUS_CHANGED
  REQUIREMENT_CHANGED
  PRICE_CHANGED
  LINK_CHANGED
  SECTION_CHANGED
  CONTENT_CHANGED
  ANNOUNCEMENT_ADDED
  DOCUMENT_ADDED
}
enum InterestType {
  DEADLINE
  ELIGIBILITY
  STATUS
  REQUIREMENT
  PRICE
  LINK
  ANNOUNCEMENT
  DOCUMENT
}
enum NotificationChannel {
  IN_APP
  EMAIL
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  ACCEPTED
  DELIVERED
  DISABLED
  BOUNCED
  COMPLAINED
}
enum EmailPurpose {
  CHANGE_ALERT
  VERIFICATION
  TEST
}
enum EmailTokenPurpose {
  VERIFY
  UNSUBSCRIBE
}
enum CheckRunStatus {
  QUEUED
  RUNNING
  RETRYING
  CANCELLED
  SUCCESS
  NO_CHANGE
  CHANGE_DETECTED
  FAILED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watches Watch[]
  interests UserInterest[]
  notifications Notification[]
  emailVerifiedAt DateTime?
  emailAlertsEnabled Boolean @default(false)
  emailSuppressedAt DateTime?
  emailSuppressionReason String?
  emailTokens EmailActionToken[]
}

model Watch {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  url String
  title String
  checkInterval Int
  isActive Boolean @default(true)
  lastCheckedAt DateTime?
  nextCheckAt DateTime @default(now())
  revision Int @default(1)
  interests InterestType[] @default([])
  minimumImportance Int @default(35)
  emailEnabled Boolean @default(true)
  includeSelector String?
  excludeSelector String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots Snapshot[]
  changes Change[]
  checkRuns CheckRun[]
  @@index([userId])
  @@index([isActive, nextCheckAt])
}

model Snapshot {
  id String @id @default(uuid()) @db.Uuid
  watchId String @db.Uuid
  content String
  contentHash String
  revision Int @default(1)
  extractionVersion Int @default(1)
  sections Json @default("[]")
  links Json @default("[]")
  finalUrl String?
  httpStatus Int?
  capturedAt DateTime @default(now())
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  oldForChanges Change[] @relation("OldSnapshot")
  newForChanges Change[] @relation("NewSnapshot")
  @@index([watchId])
  @@index([watchId, capturedAt])
}

model Change {
  id String @id @default(uuid()) @db.Uuid
  watchId String @db.Uuid
  oldSnapshotId String? @db.Uuid
  newSnapshotId String? @db.Uuid
  type ChangeType
  oldValue String?
  newValue String?
  section String?
  importance Int @default(0)
  reason String?
  checkRunId String? @db.Uuid
  eventKey String?
  severity String @default("LOW")
  confidence Float @default(0)
  isMeaningful Boolean @default(true)
  changePercentage Float @default(0)
  affectedSections Json @default("[]")
  classifierVersion Int @default(1)
  detectedAt DateTime @default(now())
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  oldSnapshot Snapshot? @relation("OldSnapshot", fields: [oldSnapshotId], references: [id], onDelete: SetNull)
  newSnapshot Snapshot? @relation("NewSnapshot", fields: [newSnapshotId], references: [id], onDelete: SetNull)
  notifications Notification[]
  @@index([watchId])
  @@index([detectedAt])
  @@index([watchId, detectedAt])
  @@unique([checkRunId, eventKey])
}

model UserInterest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  type InterestType
  enabled Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
  @@index([userId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  changeId String? @db.Uuid
  channel NotificationChannel @default(EMAIL)
  status NotificationStatus @default(PENDING)
  message String
  sentAt DateTime?
  readAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  error String?
  providerId String?
  payload Json @default("{}")
  purpose EmailPurpose @default(CHANGE_ALERT)
  checkRunId String? @db.Uuid
  watchId String? @db.Uuid
  deliveredAt DateTime?
  firstAttemptAt DateTime?
  lastProviderEventAt DateTime?
  providerMessage Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  change Change? @relation(fields: [changeId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@unique([userId, changeId, channel])
  @@index([status, nextAttemptAt])
  @@unique([userId, checkRunId, channel])
  @@unique([providerId])
}

model EmailActionToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  purpose EmailTokenPurpose
  expiresAt DateTime?
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}

model EmailWebhookEvent {
  id String @id
  providerId String
  type String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@index([providerId, processedAt])
}

model CheckRun {
  id String @id @default(uuid()) @db.Uuid
  watchId String @db.Uuid
  status CheckRunStatus @default(QUEUED)
  startedAt DateTime @default(now())
  revision Int @default(1)
  manual Boolean @default(false)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  enqueuedAt DateTime?
  leaseUntil DateTime?
  leaseOwner String?
  completedAt DateTime?
  error String?
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  @@index([watchId, startedAt])
  @@index([status, nextAttemptAt])
}

model RuntimeHeartbeat {
  id String @id
  role String
  seenAt DateTime @default(now())
}
